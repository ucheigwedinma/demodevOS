          "sort_order": 10,
          "is_active": true
        }
      ],
      "actions": [
        {
          "action_type": "require_mfa",
          "parameters": {},
          "message": "MFA is required to approve finance actions.",
          "sort_order": 10,
          "is_active": true
        }
      ]
    },
    {
