DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_SETTINGS_MODULE=config.settings.development

DB_NAME=developerOS
DB_USER=postgres
DB_PASSWORD=postgres
# Use "db" when running via Docker Compose, "localhost" for bare-metal
DB_HOST=db
DB_PORT=5432

# Use "redis" when running via Docker Compose, "localhost" for bare-metal
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Docker: http://localhost (Nginx on port 80). Bare-metal: http://localhost:5176 (Vite)
CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

ALLOWED_HOSTS=localhost,127.0.0.1,server

# Email — defaults to console backend (prints to stdout in dev)
# Uncomment below and set credentials to test real email delivery locally
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.zeptomail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=emailapikey
# EMAIL_HOST_PASSWORD=your-zeptomail-send-mail-token
# DEFAULT_FROM_EMAIL=developerOS <noreply@yourdomain.com>

# Document Search / OCR
DOCUMENT_OCR_ENABLED=False
DOCUMENT_OCR_LANG=eng
DOCUMENT_OCR_DPI=220
DOCUMENT_OCR_MAX_PAGES=20

# Optional e-sign provider base URLs (used for provider deep-link generation)
DOCUMENT_ESIGN_DOCUSIGN_SIGNING_BASE_URL=
DOCUMENT_ESIGN_ADOBE_SIGNING_BASE_URL=
DOCUMENT_ESIGN_DROPBOX_SIGNING_BASE_URL=
DOCUMENT_ESIGN_SIGNNOW_SIGNING_BASE_URL=

# OAuth / Federated Login
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost/login/oauth/callback
