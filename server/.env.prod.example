DJANGO_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-base64-48
DJANGO_SETTINGS_MODULE=config.settings.production

DB_NAME=developerOS
DB_USER=postgres
DB_PASSWORD=CHANGE-ME-strong-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Your production domain(s)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
ALLOWED_HOSTS=app.yourdomain.com,server
FRONTEND_URL=https://app.yourdomain.com

# Document Search / OCR
DOCUMENT_OCR_ENABLED=False
DOCUMENT_OCR_LANG=eng
DOCUMENT_OCR_DPI=220
DOCUMENT_OCR_MAX_PAGES=20

# Email (ZeptoMail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=CHANGE-ME-your-zeptomail-send-mail-token
DEFAULT_FROM_EMAIL=developerOS <noreply@yourdomain.com>

# Optional e-sign provider base URLs
DOCUMENT_ESIGN_DOCUSIGN_SIGNING_BASE_URL=
DOCUMENT_ESIGN_ADOBE_SIGNING_BASE_URL=
DOCUMENT_ESIGN_DROPBOX_SIGNING_BASE_URL=
DOCUMENT_ESIGN_SIGNNOW_SIGNING_BASE_URL=

# OAuth / Federated Login
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://app.yourdomain.com/login/oauth/callback
